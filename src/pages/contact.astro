---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

---

<BaseLayout title="お問い合わせ - こころ和む心理学">
  <section class="contact-page">
    <div class="page-header">
      <h1>お問い合わせ</h1>
    </div>

    <form class="contact-form" id="contact-form">
      <label>
        <span>お名前</span>
        <input type="text" name="name" required placeholder="山田 太郎" />
      </label>

      <label>
        <span>メールアドレス</span>
        <input type="email" name="email" required placeholder="example@email.com" />
      </label>

      <label>
        <span>お問い合わせ内容</span>
        <textarea name="message" rows="8" required placeholder="ご質問やご要望をご記入ください。"></textarea>
      </label>

      <button type="submit">この内容で送信する</button>
      <p id="form-status" class="form-status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const submitButton = form.querySelector('button[type="submit"]');

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = '送信中...';
      }

      status.textContent = '';
      status.className = 'form-status';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || '送信に失敗しました。');
        }

        form.reset();
        status.textContent = '送信しました。ご連絡ありがとうございます。';
        status.classList.add('success');
      } catch (error) {
        const message = error instanceof Error ? error.message : '送信に失敗しました。';
        status.textContent = message;
        status.classList.add('error');
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = '送信する';
        }
      }
    });
  }
</script>


<style>
  .contact-page {
    max-width: 820px;
    margin: 160px auto 100px;
    padding: 0 20px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3rem);
    color: #2d2d2d;
  }

  .contact-form {
    background: #fff;
    border-radius: 20px;
    padding: 50px;
    box-shadow: 0 0px 20px rgba(0, 0, 0, 0.25);
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #2d2d2d;
    margin-bottom: 20px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 2px solid #EBEBEB;
    border-radius: 12px;
    padding: 12px 14px;
    font: inherit;
    background: #F7F7F7;
    color: #000;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: #47619E;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 180px;
  }

  input::placeholder {
    color: #999;
  }

  textarea::placeholder {
    color: #999;
  }

  .contact-form button {
    display: block;
    width: 50%;
    background: #2BB7B3;
    border: none;
    border-radius: 999px;
    margin: 0 auto;
    padding: 14px 20px;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .contact-form button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .contact-form button:hover:not(:disabled) {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .form-status {
    min-height: 24px;
    margin-top: 16px;
    text-align: center;
    font-weight: 600;
  }

  .form-status.success {
    color: #1a7f4d;
  }

  .form-status.error {
    color: #c0392b;
  }

  @media screen and (max-width: 768px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .contact-page {
      margin-top: 120px;
    }
  }
</style>