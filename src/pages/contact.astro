---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="お問い合わせ - こころ和む心理学">
  <div class="page-header">
    <h1 class="page-title">お問い合わせ</h1>
  </div>
  <section class="contact-shell">
    <form class="contact-form" id="contact-form">
      <div class="form-row">
        <label class="field-label" for="name">
          <span>氏名</span>
          <span class="required-badge">必須</span>
        </label>
        <input id="name" name="name" type="text" placeholder="山田 太郎" required />
      </div>

      <div class="form-row">
        <label class="field-label" for="email">
          <span>メールアドレス</span>
          <span class="required-badge">必須</span>
        </label>
        <input id="email" name="email" type="email" placeholder="example@example.com" required />
      </div>

      <div class="form-row textarea-row">
        <label class="field-label" for="message">
          <span>お問い合わせ内容</span>
          <span class="required-badge">必須</span>
        </label>
        <textarea id="message" name="message" placeholder="お問い合わせ内容をご記入ください" required></textarea>
      </div>

      <div class="submit-row">
        <button class="submit-button" type="submit" id="submit-button" disabled>この内容で送信する</button>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  const submitButton = document.getElementById('submit-button');

  if (form && submitButton) {
    const updateSubmitState = () => {
      submitButton.disabled = !form.checkValidity();
    };

    form.addEventListener('input', updateSubmitState);
    form.addEventListener('change', updateSubmitState);
    updateSubmitState();
  }
</script>

<style>
  .page-title {
    text-align: center;
    font-size: 24px;
  }

  .contact-shell {
    width: min(900px, calc(100% - 64px));
    margin: 80px auto 120px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 18px 42px rgba(96, 68, 97, 0.12);
    padding: 56px 52px;
    box-sizing: border-box;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: center;
    column-gap: 28px;
  }

  .field-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 1.08rem;
    font-weight: 700;
    color: #604461;
  }

  .required-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    padding: 7px 14px;
    background: linear-gradient(180deg, #f7d7d8 0%, #f1c3c5 100%);
    border: 1px solid #e6b2b7;
    border-radius: 10px;
    box-shadow: inset 0 -2px 0 rgba(155, 88, 92, 0.15);
    color: #9d4d53;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  input,
  textarea {
    width: 100%;
    background: #f8f7f8;
    border: 1px solid #d8ced8;
    border-radius: 14px;
    padding: 18px 18px;
    box-sizing: border-box;
    color: #604461;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: #b4a9b8;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: #b8d7d7;
    box-shadow: 0 0 0 4px rgba(184, 215, 215, 0.2);
  }

  textarea {
    min-height: 180px;
    resize: vertical;
  }

  .textarea-row {
    align-items: flex-start;
  }

  .textarea-row .field-label {
    padding-top: 18px;
  }

  .submit-row {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .submit-button {
    appearance: none;
    border: none;
    border-radius: 999px;
    background: linear-gradient(180deg, #b8d9d8 0%, #a8d0d0 100%);
    box-shadow: 0 12px 22px rgba(120, 177, 174, 0.28);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 18px 56px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  }

  .submit-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
    box-shadow: none;
  }

  .submit-button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 14px 26px rgba(120, 177, 174, 0.34);
  }

  @media (max-width: 768px) {
    .contact-shell {
      width: min(100% - 28px, 680px);
      margin: 32px auto 60px;
      padding: 28px 20px;
    }

    .form-row {
      grid-template-columns: 1fr;
      row-gap: 10px;
    }

    .field-label {
      justify-content: flex-start;
    }

    .textarea-row .field-label {
      padding-top: 0;
    }

    .submit-button {
      width: 100%;
    }
  }
</style>